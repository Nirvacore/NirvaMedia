# =============================================================================
# Production — ai.nirva.one (Manus Space)
# Copy to .env when deploying to Manus / ai.nirva.one
# =============================================================================

PUBLIC_URL=https://ai.nirva.one
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=/app/data/nirva.db

# Manus OAuth (required on ai.nirva.one — do NOT use demo auth in production)
VITE_OAUTH_PORTAL_URL=https://manus.im
VITE_APP_ID=c94nssM6mCHuLojjUFdQbn
OAUTH_CALLBACK_PATH=/manus-oauth/callback
VITE_OAUTH_CALLBACK_PATH=/manus-oauth/callback
ALLOW_DEMO_AUTH=false

# CORS
CORS_ORIGINS=https://ai.nirva.one

# Optional AI services (configure in Manus project settings or linked infra)
VITE_OLLAMA_URL=
VITE_QDRANT_URL=
VITE_N8N_URL=
VITE_DEFAULT_MODEL=llama3.1:8b

# Cloud LLM providers (optional — or set in Settings UI client-side)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=

# Obsidian (optional — Local REST API plugin on user's machine)
OBSIDIAN_URL=http://localhost:27124
OBSIDIAN_API_KEY=
