{
  "dashboard": {
    "title": "NMD Platform - Operational Dashboard",
    "tags": ["nmd", "platform", "operations"],
    "timezone": "UTC",
    "panels": [
      {
        "title": "API Request Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(http_request_total[5m])) by (service)",
            "legendFormat": "{{ service }}"
          }
        ]
      },
      {
        "title": "Error Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(http_request_total{status=~\"5..\"}[5m])) by (service) / sum(rate(http_request_total[5m])) by (service)",
            "legendFormat": "{{ service }}"
          }
        ]
      },
      {
        "title": "Response Time (p95)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p95"
          }
        ]
      },
      {
        "title": "Response Time (p99)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p99"
          }
        ]
      },
      {
        "title": "Concurrent Requests",
        "type": "stat",
        "targets": [
          {
            "expr": "http_requests_in_flight"
          }
        ]
      },
      {
        "title": "Database Connections",
        "type": "graph",
        "targets": [
          {
            "expr": "pg_stat_activity_count"
          }
        ]
      },
      {
        "title": "Query Latency (mean)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(pg_stat_statements_mean_time[5m])",
            "legendFormat": "{{ query }}"
          }
        ]
      },
      {
        "title": "Cache Hit Rate",
        "type": "gauge",
        "targets": [
          {
            "expr": "rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]))"
          }
        ]
      },
      {
        "title": "Redis Memory",
        "type": "gauge",
        "targets": [
          {
            "expr": "redis_memory_used_bytes / redis_memory_max_bytes"
          }
        ]
      },
      {
        "title": "CPU Usage",
        "type": "gauge",
        "targets": [
          {
            "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))"
          }
        ]
      },
      {
        "title": "Memory Usage",
        "type": "gauge",
        "targets": [
          {
            "expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)"
          }
        ]
      },
      {
        "title": "Disk Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "1 - (node_filesystem_avail_bytes / node_filesystem_size_bytes)",
            "legendFormat": "{{ device }}"
          }
        ]
      },
      {
        "title": "Requests by Status Code",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum(rate(http_request_total[5m])) by (status)"
          }
        ]
      },
      {
        "title": "Top Endpoints by Traffic",
        "type": "table",
        "targets": [
          {
            "expr": "topk(10, sum(rate(http_request_total[5m])) by (endpoint))"
          }
        ]
      },
      {
        "title": "Slow Queries",
        "type": "table",
        "targets": [
          {
            "expr": "topk(10, rate(pg_stat_statements_mean_time[5m]))"
          }
        ]
      }
    ]
  }
}
