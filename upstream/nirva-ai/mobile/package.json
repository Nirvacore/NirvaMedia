{
  "name": "nmd-mobile",
  "version": "0.1.0",
  "description": "NMD Platform - Mobile Application (iOS/Android)",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "detox build-framework-cache && detox build-app-cache && detox test",
    "e2e:ios": "detox test --configuration ios.sim.debug",
    "e2e:android": "detox test --configuration android.emu.debug",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "submit:ios": "eas submit --platform ios --latest",
    "submit:android": "eas submit --platform android --latest"
  },
  "dependencies": {
    "expo": "~50.0.0",
    "expo-constants": "~15.4.0",
    "expo-device": "~5.9.0",
    "expo-image-picker": "~14.7.0",
    "expo-local-authentication": "~13.8.0",
    "expo-notifications": "~0.27.0",
    "expo-secure-store": "~12.8.0",
    "expo-splash-screen": "~0.26.0",
    "expo-status-bar": "~1.11.0",
    "expo-system-ui": "~3.0.0",
    "expo-updates": "~0.25.0",
    "react": "18.2.0",
    "react-native": "0.73.0",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-paper": "^5.12.0",
    "react-native-reanimated": "~3.6.0",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-sqlite-storage": "^6.0.0",
    "react-native-webview": "13.8.5",
    "react-navigation": "^4.4.4",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.12",
    "@react-navigation/stack": "^6.3.20",
    "@react-navigation/drawer": "^6.6.8",
    "redux": "^4.2.1",
    "@reduxjs/toolkit": "^1.9.7",
    "react-redux": "^8.1.3",
    "redux-persist": "^6.0.0",
    "axios": "^1.6.2",
    "lodash": "^4.17.21",
    "date-fns": "^2.30.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.7",
    "@shopify/flash-list": "1.6.3",
    "react-native-svg": "14.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.2",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^29.5.8",
    "@types/react": "^18.2.37",
    "@types/react-native": "^0.72.6",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "detox": "^20.13.1",
    "detox-cli": "^20.13.1",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.2",
    "jest": "^29.7.0",
    "jest-expo": "~50.0.0",
    "prettier": "^3.1.0",
    "typescript": "^5.2.2",
    "ts-jest": "^29.1.1",
    "watermelondb": "^0.26.2"
  },
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
