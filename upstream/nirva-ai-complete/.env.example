# NMD Platform Configuration

# Environment
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@postgres:5432/nmd_db
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_TIMEOUT=30000

# Cache
REDIS_URL=redis://redis:6379/0
REDIS_TTL=3600
CACHE_STRATEGY=lru

# API Configuration
API_KEY_HEADER=Authorization
API_RATE_LIMIT_WINDOW=900000
API_RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=*

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d
JWT_ALGORITHM=HS256
HASH_ITERATIONS=10000
ENCRYPTION_ALGORITHM=aes-256-cbc

# Webhooks
WEBHOOK_TIMEOUT=30000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=1000

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_BATCH_SIZE=100
ANALYTICS_FLUSH_INTERVAL=60000

# Monitoring & Logging
LOG_LEVEL=info
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
SENTRY_DSN=

# Performance
ENABLE_COMPRESSION=true
COMPRESSION_LEVEL=6
ENABLE_CACHING=true
CACHE_HIT_RATE_TARGET=0.7

# Third-party Services
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=nmd-platform-bucket

# AI Services
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@nmd.platform

# Security
ENABLE_RATE_LIMITING=true
ENABLE_INPUT_VALIDATION=true
ENABLE_CORS=true
SECURE_HEADERS_ENABLED=true
HELMET_ENABLED=true

# Feature Flags
FEATURE_AI_ASSISTANT=true
FEATURE_ADVANCED_SEARCH=true
FEATURE_WEBHOOKS=true
FEATURE_ANALYTICS=true
FEATURE_ROI_TRACKING=true

# Debug
DEBUG=false
VERBOSE_LOGGING=false
ENABLE_REQUEST_LOGGING=true
