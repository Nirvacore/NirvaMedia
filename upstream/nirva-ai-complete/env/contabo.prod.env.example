# Contabo VPS production — copy to env/contabo.prod.env
# cp env/contabo.prod.env.example env/contabo.prod.env

PUBLIC_URL=https://ai.nirva.one
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=/app/data/nirva.db

# Auth — demo login for team; switch to OAuth when ready
ALLOW_DEMO_AUTH=true
CORS_ORIGINS=https://ai.nirva.one

# OAuth (optional — if not using demo auth)
# VITE_OAUTH_PORTAL_URL=https://manus.im
# VITE_APP_ID=
# OAUTH_CALLBACK_PATH=/api/oauth/callback
# VITE_OAUTH_CALLBACK_PATH=/api/oauth/callback

VITE_DEFAULT_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text
QDRANT_COLLECTION=nirva_memory

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
LOG_REQUESTS=true

# Obsidian (optional)
OBSIDIAN_URL=http://localhost:27124
OBSIDIAN_API_KEY=

# Cloud LLM providers (optional)
# OPENAI_API_KEY=

# Dashboard host port on VPS (nirvacore uses 3000-3001 — Nirva defaults to 3100)
# DASHBOARD_HOST_PORT=3100
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
